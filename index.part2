/* -------------------------------------------------------
   SAVE FUNCTION
-------------------------------------------------------- */
function saveData() {
    localStorage.setItem("notesportal", JSON.stringify(data));
}

/* -------------------------------------------------------
   RENDER LECTURES
-------------------------------------------------------- */
function renderLectures() {
    const list = document.getElementById("lectureList");
    list.innerHTML = "";

    data.forEach((lec, index) => {
        let card = document.createElement("div");
        card.className = "card";

        card.innerHTML = `
            <h3>${lec.title}</h3>
            <iframe width="100%" height="250" src="${lec.url}" frameborder="0" allowfullscreen></iframe>
            <button class="noteAddBtn" data-id="${index}">Add Note</button>
            <button class="delBtn" data-id="${index}">Delete Lecture</button>
            <div class="notesBox" id="notes-${index}"></div>
        `;

        list.appendChild(card);

        /* Disable buttons for non-admin */
        if (!isAdmin) {
            card.querySelector(".noteAddBtn").disabled = true;
            card.querySelector(".delBtn").style.display = "none";
        }

        renderNotes(index);
    });

    bindButtons();
}

/* -------------------------------------------------------
   RENDER NOTES
-------------------------------------------------------- */
function renderNotes(lecIndex) {
    const box = document.getElementById("notes-" + lecIndex);
    box.innerHTML = "";

    data[lecIndex].notes.forEach((note, i) => {
        let div = document.createElement("div");
        div.className = "noteBox";

        div.innerHTML = `
            <p>${note}</p>
            <button class="delNoteBtn" data-lec="${lecIndex}" data-note="${i}">Delete Note</button>
        `;

        if (!isAdmin) {
            div.querySelector(".delNoteBtn").style.display = "none";
        }

        box.appendChild(div);
    });
}

/* -------------------------------------------------------
   BIND BUTTONS AFTER RENDER
-------------------------------------------------------- */
function bindButtons() {
    document.querySelectorAll(".delBtn").forEach(btn => {
        btn.onclick = function () {
            if (!isAdmin) return alert("Admin only!");
            let id = this.getAttribute("data-id");
            data.splice(id, 1);
            saveData();
            renderLectures();
        };
    });

    document.querySelectorAll(".noteAddBtn").forEach(btn => {
        btn.onclick = function () {
            if (!isAdmin) return alert("Admin only!");
            let id = this.getAttribute("data-id");
            let txt = prompt("Enter your note:");
            if (txt) {
                data[id].notes.push(txt);
                saveData();
                renderLectures();
            }
        };
    });

    document.querySelectorAll(".delNoteBtn").forEach(btn => {
        btn.onclick = function () {
            if (!isAdmin) return alert("Admin only!");
            let lecId = this.getAttribute("data-lec");
            let noteId = this.getAttribute("data-note");
            data[lecId].notes.splice(noteId, 1);
            saveData();
            renderLectures();
        };
    });
}

/* -------------------------------------------------------
   ADD LECTURE BUTTON
-------------------------------------------------------- */
document.getElementById("addLectureBtn").onclick = function () {
    if (!isAdmin) return alert("Admins only!");

    let title = prompt("Lecture Title:");
    let url = prompt("YouTube embed URL (use embed link):");

    if (title && url) {
        data.push({
            title,
            url,
            notes: []
        });
        saveData();
        renderLectures();
    }
};

/* -------------------------------------------------------
   ADD NOTE BUTTON
-------------------------------------------------------- */
document.getElementById("addNoteBtn").onclick = function () {
    if (!isAdmin) return alert("Admins only!");

    let index = prompt("Enter lecture number to add note (0 to " + (data.length - 1) + "):");
    let txt = prompt("Enter note text:");

    if (index !== null && txt) {
        index = parseInt(index);
        if (!isNaN(index) && data[index]) {
            data[index].notes.push(txt);
            saveData();
            renderLectures();
        } else {
            alert("Invalid lecture index!");
        }
    }
};

/* -------------------------------------------------------
   SEARCH FUNCTION
-------------------------------------------------------- */
document.getElementById("searchBtn").onclick = function () {
    let q = document.getElementById("searchInput").value.toLowerCase();

    if (!q.trim()) {
        renderLectures();
        return;
    }

    const list = document.getElementById("lectureList");
    list.innerHTML = "";

    data.forEach((lec, index) => {
        if (lec.title.toLowerCase().includes(q)) {
            let card = document.createElement("div");
            card.className = "card";

            card.innerHTML = `
                <h3>${lec.title}</h3>
                <iframe width="100%" height="250" src="${lec.url}" frameborder="0" allowfullscreen></iframe>
                <button class="noteAddBtn" data-id="${index}">Add Note</button>
                <button class="delBtn" data-id="${index}">Delete Lecture</button>
                <div class="notesBox" id="notes-${index}"></div>
            `;

            list.appendChild(card);

            if (!isAdmin) {
                card.querySelector(".noteAddBtn").disabled = true;
                card.querySelector(".delBtn").style.display = "none";
            }

            renderNotes(index);
        }
    });
};
